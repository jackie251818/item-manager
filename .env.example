# ===== 必填 =====
# 初始管理员密码（首次启动哈希入库；改了就覆盖旧密码）
ADMIN_PASSWORD=change-me-in-production-please
# Flask session + CSRF + 图片签名密钥（32 字节随机字符串）
SECRET_KEY=please-generate-a-random-secret-key-here

# ===== 可选 =====
# 数据库文件路径（默认 /app/data/items.db）
DB_PATH=/app/data/items.db

# 管理员用户名（默认 admin）
ADMIN_USERNAME=admin

# 端口（容器内部，映射到宿主机在 docker-compose.yml ports 段改）
PORT=5000

# 上传目录
UPLOAD_PATH=/app/data/uploads
